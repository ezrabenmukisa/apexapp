# Apex app configuration. Copy to `.env` (gitignored) and adjust:
#   cp .env.example .env

# Base URL of the Apex REST API, including the /api/v1 prefix.
# Backend running on your laptop (Android emulator): http://10.0.2.2:8000/api/v1
API_BASE_URL=https://apex.pntr.dev/api/v1

# Google Maps key for the project site-pin map (Maps SDK for Android/iOS).
# Restrict it in Google Cloud to the app id com.apex.app and our SHA-1s.
GOOGLE_MAPS_API_KEY=

# Features whose endpoints aren't live yet run on the in-app mock server.
# Set to true as each backend endpoint ships.
LIVE_PROJECTS=true
LIVE_MILESTONES=true
LIVE_EVIDENCE=true
LIVE_NOTIFICATIONS=true

# true = fake GPS, camera, receipt picker and permissions (desktop, demos).
# Leave false on a phone: real evidence needs real photos and locations.
SIMULATE_DEVICE=false
