# Apex app configuration. Copy to `.env` (gitignored) and adjust:
#   cp .env.example .env

# Base URL of the Apex REST API, including the /api/v1 prefix.
# Backend running on your laptop (Android emulator): http://10.0.2.2:8000/api/v1
API_BASE_URL=https://apex.pntr.dev/api/v1

# Features whose endpoints aren't live yet run on the in-app mock server.
# Set to true as each backend endpoint ships.
LIVE_PROJECTS=false
LIVE_MILESTONES=false
LIVE_EVIDENCE=false
LIVE_NOTIFICATIONS=false
